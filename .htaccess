<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent directory listing
    Options -Indexes

    # Block access to hidden files and sensitive directories
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|plan\.txt) - [F,L,NC]
    RewriteRule ^storage/ - [F,L,NC]
    RewriteRule ^app/ - [F,L,NC]
    RewriteRule ^config/ - [F,L,NC]
    RewriteRule ^templates/ - [F,L,NC]
    RewriteRule ^cron/ - [F,L,NC]

    # Redirect root requests to /public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
