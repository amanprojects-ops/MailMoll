<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent directory listing
    Options -Indexes

    # Pass HTTP Authorization Header to PHP
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

    # Block access to hidden files and sensitive directories
    RewriteRule ^(\.env|\.git|composer\.(json|lock)) - [F,L,NC]
    RewriteRule ^storage/ - [F,L,NC]
    RewriteRule ^app/ - [F,L,NC]
    RewriteRule ^config/ - [F,L,NC]
    RewriteRule ^templates/ - [F,L,NC]
    RewriteRule ^cron/ - [F,L,NC]

    # Serve static assets directly from public/assets/ if requested via /assets/...
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]

    # If the file or directory exists in root, serve directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all application requests through root index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
